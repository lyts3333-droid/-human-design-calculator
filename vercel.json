{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12",
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    { "src": "/callback", "dest": "app.py" },
    { "src": "/callback/", "dest": "app.py" },
    { "src": "/api/line/callback", "dest": "app.py" },
    { "src": "/api/line/callback/", "dest": "app.py" },
    { "src": "/(.*)", "dest": "app.py" }
  ],
  "env": {
    "VERCEL": "1",
    "PYTHON_VERSION": "3.12"
  }
}
