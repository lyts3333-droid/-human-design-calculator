{
  "version": 2,
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12",
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    { "src": "/callback", "dest": "app.py" },
    { "src": "/callback/", "dest": "app.py" },
    { "src": "/api/line/callback", "dest": "app.py" },
    { "src": "/api/line/callback/", "dest": "app.py" },
    { "src": "/calculate_hd", "dest": "app.py" },
    { "src": "/health", "dest": "app.py" },
    { "src": "/gene_keys.csv", "dest": "app.py" },
    { "src": "/api/(.*)", "dest": "app.py" },
    { "src": "/(.*)", "dest": "web/$1" }
  ],
  "env": {
    "VERCEL": "1",
    "PYTHON_VERSION": "3.12"
  }
}
